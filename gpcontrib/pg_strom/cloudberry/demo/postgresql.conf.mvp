# Apply this file to the coordinator, all primaries, and all mirrors before
# starting the multi-segment demo.
shared_preload_libraries = 'pg_strom'
max_worker_processes = 16

# The single-host demo shares one GPU among independent QD/QE services.  The
# shared budget is keyed by OS user and physical GPU UUID, so 0.20 is the total
# admission limit across all postmasters rather than a per-service allowance.
# A request waits at most five seconds before failing explicitly.
pg_strom.shared_gpu_budget_ratio = 0.20
pg_strom.shared_gpu_budget_timeout = '5s'
pg_strom.gpu_mempool_segment_sz = '256MB'
pg_strom.gpu_mempool_max_ratio = 0.20
pg_strom.cpu_fallback = 'off'
pg_strom.enabled = on
pg_strom.enable_gpuscan = on
pg_strom.enable_gpupreagg = off
pg_strom.enable_partitionwise_gpupreagg = off
pg_strom.enable_numeric_aggfuncs = off
pg_strom.enable_gpusort = off

# Gather-only GpuPreAgg is registered as a default-off experimental path.
# The Cloudberry MVP does not register GpuJoin/GpuCache, BRIN acceleration,
# Arrow, SELECT-INTO-Direct, or DPU planner hooks.  GPU-Sort, numeric and
# partitionwise GpuPreAgg remain disabled.  GPU-Direct and SELECT-INTO-Direct
# are also hard-disabled by the build.
